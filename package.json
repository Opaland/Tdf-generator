{
  "name": "etapeforge",
  "version": "1.0.0",
  "description": "ÉtapeForge — générateur d'étapes du Tour de France : éditeur, reconstruction historique 1903→2027, fiches côte-par-côte, analyse km par km. 100 % local (Node.js + SQLite), aucun compte, aucune dépendance cloud propriétaire.",
  "license": "MIT",
  "type": "commonjs",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "generate": "node pipeline/cli.js",
    "import": "node pipeline/cli.js --import",
    "demo": "node scripts/demo.js",
    "demo:2027": "node scripts/demo-2027.js --online",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "fit-file-parser": "^4.1.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
